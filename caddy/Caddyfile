# Tailscale IPでHTTPSを終端（証明書は自己署名）
:80 {
    route /fudebako* {
        uri strip_prefix /fudebako
        root * /srv/fudebako
        file_server
    }

    route /ocr* {
        reverse_proxy ocr-api:8000
    }

    route /guideline* {
        uri strip_prefix /guideline
        reverse_proxy guideline-api:8001
    }

    route /schedule* {
        reverse_proxy ocr-api:8000
    }

    route /health {
        reverse_proxy ocr-api:8000
    }

    route /trouble/line/webhook {
        uri strip_prefix /trouble
        reverse_proxy trouble-api:8002
    }

    route /trouble/webex/webhook {
        uri strip_prefix /trouble
        reverse_proxy trouble-api:8002
    }

    route /trouble/liff* {
        uri strip_prefix /trouble
        reverse_proxy trouble-api:8002
    }

    route /trouble* {
        basic_auth {
            ncbtrouble {$TROUBLE_BASIC_AUTH_HASH}
        }
        uri strip_prefix /trouble
        reverse_proxy trouble-api:8002
    }

    route /mermaid/assets* {
        uri strip_prefix /mermaid
        reverse_proxy mermaid-api:8004
    }

    route /mermaid* {
        basic_auth {
            ncbmermaid {$MERMAID_BASIC_AUTH_HASH}
        }
        uri strip_prefix /mermaid
        reverse_proxy mermaid-api:8004 {
            flush_interval -1
        }
    }

    route /tango* {
        uri strip_prefix /tango
        reverse_proxy tango:8005
    }

    route /kobun* {
        uri strip_prefix /kobun
        reverse_proxy kobun-api:8006
    }

    # transcribe-api はホスト上で native 実行（mlx-whisper が Apple Silicon 専用のため）
    route /transcribe* {
        uri strip_prefix /transcribe
        reverse_proxy host.docker.internal:8007
    }

    route /gpt-image* {
        basic_auth {
            ncbgpt {$GPT_IMAGE_BASIC_AUTH_HASH}
        }
        uri strip_prefix /gpt-image
        reverse_proxy gpt-image:8003 {
            flush_interval -1
        }
    }
}
