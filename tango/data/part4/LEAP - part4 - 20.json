      "id": "1601",
      "word": "crack",
      "phonetic": "[kræk]",
      "level_tag": "B2",
      "definitions": [
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "① 割れる, 砕ける",
            "② (バンと)音を出す"
          ]
        },
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "③ 〜を割る, 砕く"
          ]
        },
        {
          "part_of_speech": "名詞",
          "meanings": [
            "④ 割れ目"
          ]
        }
      ],
      "usages_and_notes": [
        "▶ ②「鋭い音を立てる」→①③「(鋭い音を立てて)割れる, 砕く」",
        "＊cracker「クラッカー, 爆竹」は「派手な音を出すおもちゃ(花火)」",
        "◎crack down on 〜「(違法行為など)を取り締まる」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "The wall cracked in several places.",
          "ja": "① 壁はいくつかの場所でひび割れていた."
        },
        {
          "en": "A shot cracked across the ridge.",
          "ja": "② 1発の銃声が尾根に鳴り響いた."
        },
        {
          "en": "crack two eggs into the frying pan",
          "ja": "③ 2つの卵を割ってフライパンに入れる"
        },
        {
          "en": "cracks in a cup",
          "ja": "④ カップのひび"
        }
      ]
    },
