      "word": "confess",
      "phonetic": "[kənfés]",
      "level_tag": "B2",
      "definitions": [
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "① (to ~) (~を)白状する"
          ]
        },
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "② 〜を認める"
          ]
        }
      ],
      "usages_and_notes": [
        "▶「(罪や自分にとって不利益となることを)白状する」(*② 日常では admit のほうが使われる。)",
        "派生 名 confession「告白」"
      ],
      "word_origin": {
        "formula": "con-[すべて] + -fes-[言う]",
        "description": "infant「幼児(←ものを言えぬ者)」, prophet「予言者」(-phe- = -fe-)"
      },
      "examples": [
        {
          "en": "confess to the crime",
          "ja": "① 犯罪を白状する"
        },
        {
          "en": "confess my ignorance",
          "ja": "② 無知を認める"
        }
      ]
    },
