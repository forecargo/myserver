    {
      "id": "1188",
      "word": "secure",
      "phonetic": "[sikjúər]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "① (場所、地位、契約など)を確保する",
            "② (睡眠時間などを)確保する"
          ]
        },
        {
          "part_of_speech": "形容詞",
          "meanings": [
            "① 安全な",
            "② 守られて"
          ]
        }
      ],
      "usages_and_notes": [
        "▶「睡眠時間を確保する」は get enough sleep という表現が適切。",
        "se- [離れて] + -cure [心配] から「心配がない」→「安全で」",
        "security「(国家などの)安全, 防犯, 防衛」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "secure a window seat",
          "ja": "窓側の席を確保する"
        },
        {
          "en": "feel secure about the future",
          "ja": "将来に対して安心感をもつ"
        }
      ]
    },
