  "vocabulary_list": [
    {
      "id": "1160",
      "word": "settle",
      "phonetic": "[sétl]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "① (紛争など)を解決する",
            "② 〜を置く, 据える"
          ]
        },
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "③ 定住する",
            "④ (on 〜) (〜を)決める"
          ]
        }
      ],
      "usages_and_notes": [
        "▶ set-(=seat 座らせる)→「固定する, 解決する, 定住する」",
        "名 settlement「解決, 定住, 入植」",
        "熟 settle for 〜「〜で我慢する, (不本意だが)〜で手打つ」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "settle the dispute",
          "ja": "その紛争を解決する"
        },
        {
          "en": "settle a bag on my shoulder",
          "ja": "バッグを肩にかける(置く)"
        },
        {
          "en": "settle (down) in Brazil",
          "ja": "ブラジルに定住する"
        },
        {
          "en": "settle on a name for our new dog",
          "ja": "私たちの新しいイヌの名前を決める"
        }
      ]
    },
