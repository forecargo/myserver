    {
      "id": "1391",
      "word": "barely",
      "phonetic": "[bέərli]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "副",
          "meanings": [
            "① かろうじて",
            "② ほとんど〜ない"
          ]
        }
      ],
      "usages_and_notes": [
        "▶ ある基準から＋2〜3%→「かろうじて」 ② 100%のうち2〜3%→「ほとんど〜ない」 (*①enough, adequateなどを伴う.)",
        "派生 bare「むき出しの」から「それしかない」→「かろうじて」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "barely enough food to go around",
          "ja": "① かろうじて行き渡るだけの食物"
        },
        {
          "en": "Nancy was quite old and barely able to walk.",
          "ja": "② ナンシーはとても高齢で, ほとんど歩けなかった."
        }
      ]
    },
    {
