      "word": "propose",
      "phonetic": "[prəpóuz]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "① 〜を提案する"
          ]
        },
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "② (to 〜)(〜に)結婚を申し込む"
          ]
        }
      ],
      "usages_and_notes": [
        "▶「(十分に練って)申し出る」(※suggestよりも堅い。)",
        "名 proposal「提案」",
        "名 proponent「支持者」(⇔opponent「反対者」)"
      ],
      "word_origin": {
        "formula": "pro-[前方] + -pose[置く] から「差し出す」→「提案する」",
        "description": null
      },
      "examples": [
        {
          "en": "① propose a new program",
          "ja": "① 新しい計画を提案する"
        },
        {
          "en": "② get down on my knee to propose to her",
          "ja": "② 片膝ついて彼女にプロポーズする"
        }
      ]
    },
