      "phonetic": "[kwɔ́ləfài]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "① (for ~) (~の) 資格がある",
            "② (as ~) (~としての) 資格を得る"
          ]
        },
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "③ 〜に資格を与える"
          ]
        }
      ],
      "usages_and_notes": [
        "注意: ①② be qualifiedの形も可。"
      ],
      "word_origin": {
        "formula": "quali-[質] + -fy[与える]",
        "description": "qualified「資格のある, 適格の」, qualification「資格」"
      },
      "examples": [
        {
          "en": "① qualify for bank loans",
          "ja": "① 銀行ローンを受ける資格がある"
        },
        {
          "en": "② qualify as a teacher",
          "ja": "② 教師としての資格を得る"
        },
        {
          "en": "③ a World Cup qualifying game",
          "ja": "③ ワールドカップの予選 (本選への資格を与える試合)"
        }
      ]
    },
