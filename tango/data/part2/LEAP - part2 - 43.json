      "phonetic": "[inváiərənəmənt]",
      "level_tag": "B2",
      "definitions": [
        {
          "part_of_speech": "名詞",
          "meanings": [
            "① 環境, 周囲 (の状況)",
            "② (人を取り巻く)自然[社会]的環境, 状況"
          ]
        }
      ],
      "usages_and_notes": [
        "surroundings「周囲」は「場所」を表す場合が多い。",
        "「地球の自然環境」を表す場合には必ず the がつく。",
        "形 environmental「環境の」",
        "副 environmentally「環境に」",
        "environmentally friendly products「環境に優しい製品」",
        "environmentalist「環境保護論者」",
        "参 green「環境にやさしい」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "the natural environment",
          "ja": "自然環境"
        }
      ]
    },
