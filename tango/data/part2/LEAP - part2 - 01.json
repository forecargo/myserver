  "vocabulary_list": [
    {
      "id": "401",
      "word": "debate",
      "phonetic": "[dibéit]",
      "level_tag": "A2",
      "definitions": [
        {
          "part_of_speech": "名詞",
          "meanings": [
            "① 討論"
          ]
        },
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "② 〜を討論する"
          ]
        }
      ],
      "usages_and_notes": [
        "▶ 主に「公開の場で(賛成, 反対に分かれて)議論する」",
        "◇ discuss「(ある問題)について意見を交換する」",
        "頻出 ① have[hold, conduct] a debate「討論会を開く」",
        "語法 専門的な話題は(on ~), 一般的な話題は(over[about] ~)",
        "☆battle「戦い」"
      ],
      "word_origin": {
        "formula": "de-[強意] + -bat-[=bat たたく] -> 「たたき合い」",
        "description": null
      },
      "examples": [
        {
          "en": "the debate on whaling",
          "ja": "捕鯨に関する討論"
        },
        {
          "en": "debate the pros and cons of this",
          "ja": "この是非について話し合う"
        }
      ]
    },
    {
