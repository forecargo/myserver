    {
      "id": "408",
      "word": "bound",
      "phonetic": "[báund]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "形",
          "meanings": [
            "① (to do) きっと〜する (〜する[である]に違いない)",
            "② (for 〜) 〜行きで"
          ]
        }
      ],
      "usages_and_notes": [
        "▶「縛られた」から「身動きが取れない」→①「きっと〜(するに決まっている)」②「〜行き(と決まっている)」",
        "頻出 ①〈口語〉be bound to do「きっと〜する」",
        "② be bound for 〜「〜行きで」",
        "注意 ①類義語の must「〜に違いない」は「未来の推量」には使えない。",
        "★元は bind「〜を縛る」の過去分詞。"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "He is bound to be in the classroom now.",
          "ja": "今彼はきっと教室にいるはずだ."
        },
        {
          "en": "the Nozomi Superexpress bound for Tokyo",
          "ja": "東京行きののぞみ号"
        }
      ]
    },
