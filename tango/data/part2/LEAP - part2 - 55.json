{
  "vocabulary_list": [
    {
      "id": "800",
      "word": "available",
      "phonetic": "[əvéiləbl]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "形容詞",
          "meanings": [
            "① 手に入る、利用できる",
            "② (人の予定が)空いている"
          ]
        }
      ],
      "usages_and_notes": [
        "▶「入手可能」な（訳語は文脈で考える。）",
        "頻出 ① readily [easily] available 「容易に手に入る」",
        "注意 〈最上級 + available〉は「入手[利用]可能な中で最も〜」という意味。",
        "語源 a-[=ad 方向] + -vail[=value 価値] + -able[可能] →「〜(の価値)を利用できる」",
        "名 availability「利用できること、有効性」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "This T-shirt is available in all sizes.",
          "ja": "このTシャツはすべてのサイズでご用意できます(手に入る)."
        },
        {
          "en": "Mr. Rogers is available today.",
          "ja": "ロジャース氏は本日時間がとれます."
        }
      ]
    },
    {
      "id": "801",
