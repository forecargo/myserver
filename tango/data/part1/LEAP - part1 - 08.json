      "word": "condition",
      "phonetic": "[kəndíʃən]",
      "level_tag": "A2",
      "definitions": [
        {
          "part_of_speech": "名詞",
          "meanings": [
            "① 状態, 容態",
            "② (通例 -s) (周囲の)状況, 条件"
          ]
        }
      ],
      "usages_and_notes": [
        "▶ ①「(人や物の一時的な)状況, 状態」",
        "▶ ②「(仕事場, 気象などの)状況」",
        "頻出 ① in (a[an]) condition「〜の状態で」",
        "② on (〈米〉under) (the) condition that SV「〜という条件で」",
        "形 conditional「条件付きの」⇔ a conditional offer「条件付きの申し出」",
        "形 unconditional「無条件の」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "My body is in good condition.",
          "ja": "私の体は調子がよい。"
        },
        {
          "en": "work under bad conditions",
          "ja": "悪条件の下で働く"
        }
      ]
    },
