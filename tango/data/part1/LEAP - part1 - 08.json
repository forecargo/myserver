    {
      "id": "053",
      "word": "suffer",
      "phonetic": "[sʌ́fər]",
      "level_tag": "B1",
      "definitions": [
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "① (from 〜) (病気などで)苦しむ"
          ]
        },
        {
          "part_of_speech": "他動詞",
          "meanings": [
            "② (苦痛, 損害)を経験する"
          ]
        }
      ],
      "usages_and_notes": [
        "頻出 suffer a blow[setback]「一撃を受ける[痛手を被る]」",
        "注意 ① 一時的な状態であることを示す場合は進行形で表現する.",
        "名 suffering「苦痛, 苦しみ」"
      ],
      "word_origin": {
        "formula": "suf-(=sub 下) + -fer[運ぶ]",
        "description": "から「何かの下に自らを運ぶ」→「苦しむ, 経験する」"
      },
      "examples": [
        {
          "en": "I am suffering from jet lag.",
          "ja": "時差ぼけに苦しんでいる。"
        },
        {
          "en": "The company suffered a heavy loss.",
          "ja": "その会社は大きな損失を出した (大きな損失を経験した)。"
        }
      ]
    },
