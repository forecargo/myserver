      "level_tag": "A2",
      "definitions": [
        {
          "part_of_speech": "自動詞",
          "meanings": [
            "① (物, 事が主語) on 〜によって決まる",
            "② (人が主語) (on 〜)に頼っている"
          ]
        }
      ],
      "usages_and_notes": [
        "▶ ①「〜次第である」 ②「〜に(全面的に)頼っている」",
        "頻出 depend on 〜",
        "That depends.「それはケースバイケースだ.」",
        "▶ pendant「ペンダント」と同様に「(人に)ぶら下がる」イメージ.",
        "名 dependent「依存している」",
        "名 dependence「依存」"
      ],
      "word_origin": null,
      "examples": [
        {
          "en": "Your success depends on how much effort you make.",
          "ja": "成功は君の努力(君がどれくらい努力するか)次第だ."
        },
        {
          "en": "I depend on my parents for university tuition.",
          "ja": "私は両親に大学の学費を頼っている."
        }
      ]
    },
